# Copy to .env and edit. .env is ignored by git. Never commit real keys.

# Where the Torob CSVs live, and where the built SQLite DB goes
STARCOACH_DATA_DIR=data/torob-dataset
STARCOACH_DB=data/starcoach.db
STARCOACH_LOG_DIR=logs
STARCOACH_HOST=127.0.0.1
STARCOACH_PORT=8000

# Optional LLM (any OpenAI-compatible endpoint). Empty = rule-based only.
# Example values: https://api.example.com/v1 / sk-fake-example-key / example-model
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
